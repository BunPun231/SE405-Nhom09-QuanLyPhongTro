# ======================================================================
# Smart Room Rental SaaS — Environment Variables
# Copy to .env and fill in your values
# ======================================================================

# --- Database (PostgreSQL) ---
DB_URL=jdbc:postgresql://localhost:15432/rental_management
DB_USERNAME=rental_dev
DB_PASSWORD=rental_dev_pass

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=16379

# --- JWT ---
JWT_SECRET=change-me-super-secret-key-at-least-32-characters-long
JWT_ACCESS_TOKEN_MINUTES=60

# --- Spring ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# --- Admin Bootstrap ---
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_TENANT_NAME=System Administration
ADMIN_FULL_NAME=System Administrator
ADMIN_PHONE=0900000000
ADMIN_EMAIL=admin@roomrental.com
ADMIN_PASSWORD=Admin@1234

# --- Database Pool (optional) ---
DB_POOL_SIZE=5
DB_POOL_MIN_IDLE=1
DB_CONNECTION_TIMEOUT=10000

# --- Cloudinary (for image uploads) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- OCR Provider ---
OCR_PROVIDER = GEMINI # Supported values: GOOGLE_VISION, GEMINI
GEMINI_API_KEY = your_gemini_api_key_here
GEMINI_MODEL = gemini-3.5-flash # or gemini-3.1-flash-lite, etc.

# --- SePay Webhook ---
# API Key for verifying SePay webhook signatures (optional but recommended in production)
SEPAY_API_KEY=your_sepay_webhook_api_key_here
SEPAY_WEBHOOK_URL=https://your-domain.com/api/v1/payments/webhook
SEPAY_API_URL=https://bankhub-api.sepay.vn/v1/webhook

# --- Firebase Cloud Messaging (FCM) ---
# Path to firebase service account private key JSON file for backend FCM pushes (optional, fallbacks to classpath)
FIREBASE_CREDENTIALS_PATH=d:\RentalManagement\backend\src\main\resources\firebase-service-account.json

