# syntax=docker/dockerfile:1
FROM eclipse-temurin:21-jdk-alpine AS build
WORKDIR /app

# Copy Maven wrapper & pom.xml first to cache dependencies layer
COPY backend/.mvn .mvn
COPY backend/mvnw backend/pom.xml ./
RUN chmod +x mvnw

# Pre-fetch Maven dependencies into BuildKit cache mount
RUN --mount=type=cache,target=/root/.m2 ./mvnw dependency:go-offline -B || true

# Copy source code and build jar using BuildKit cache mount
COPY backend/src src
RUN --mount=type=cache,target=/root/.m2 ./mvnw package -DskipTests -B

# Runtime stage (Alpine JRE for lightweight container & fast startup)
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
COPY --from=build /app/target/*.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
